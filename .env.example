# -----------------------------------------------------------------------------
# FreeAgentsLTD unified environment template
#
# Copy this file to `.env` in the root of your assembled monorepo and fill in
# the values.  All keys listed here are used by the website (`apps/web`),
# bot/worker (`apps/bot-worker`) and shared services.  Groupings are provided
# for clarity.  Remove comments when copying into production systems if
# necessary.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# MongoDB connection URI used by both the website and the bot/worker.
MONGODB_URI=

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Base URL for building full links inside the bot and website.  Typically the
# public hostname of your website (e.g. https://example.com).
APP_URL=http://localhost:3000
# Public-facing URL of the Next.js frontend.  Used by the website to compute
# absolute URLs when necessary.
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# NextAuth (website)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Discord OAuth (website) – client credentials used by NextAuth
# -----------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The guild where users must be present to access the site.  This must
# match the guild ID configured in the bot/worker.
DISCORD_GUILD_ID=1457959036304756736
# Role assigned upon successful verification.  Must correspond to a role
# created in your Discord server.
DISCORD_MEMBER_ROLE_ID=

# -----------------------------------------------------------------------------
# Stripe (website)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Public publishable key used on the client side.  Must match the key
# configured in Stripe dashboard.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Cloudinary (website)
# -----------------------------------------------------------------------------
# Credentials for uploading images to Cloudinary.  Only used by the website.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Bot/Worker Service URLs (website) – used by the website to call internal
# endpoints exposed by the bot/worker service.  Adjust ports if running
# services locally.
# -----------------------------------------------------------------------------
BOT_WORKER_URL=http://localhost:4000
SHARED_SERVICE_URL=http://localhost:4001

# -----------------------------------------------------------------------------
# Discord Bot (bot/worker)
# -----------------------------------------------------------------------------
# Discord bot token for logging into Discord.  Obtain from the Discord
# developer portal.
DISCORD_BOT_TOKEN=
# Channel ID where the bot posts the verification message.
DISCORD_VERIFY_CHANNEL_ID=

# -----------------------------------------------------------------------------
# Internal Secrets (bot/worker)
# -----------------------------------------------------------------------------
# Shared secret used to authenticate API requests coming from the website to
# the bot/worker.  Keep this long and random.
INTERNAL_SHARED_SECRET=
# Secret used to protect cron/job endpoints exposed by the bot/worker.  The
# same value must be provided when invoking these endpoints.
CRON_SECRET=
# Optional encryption key used for hashing verification tokens.  Leave empty
# to allow the service to generate a random key at runtime.
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Privileged User IDs (bot/worker)
# -----------------------------------------------------------------------------
# Comma‑separated list of Discord user IDs who should always be treated as
# owners.  Owners have the highest level of access and cannot be removed
# through normal role mappings.
OWNER_USER_IDS=
# Comma‑separated list of Discord user IDs who have admin privileges.  Admins
# can manage most aspects of the platform but cannot override owners.
ADMIN_USER_IDS=

# -----------------------------------------------------------------------------
# Sync Flags (bot/worker)
# -----------------------------------------------------------------------------
# Whether the bot should synchronise site roles to Discord roles.  If false,
# role synchronisation is disabled.
DISCORD_ROLE_SYNC_ENABLED=true
# Whether Discord roles should be allowed to update site roles.  This is
# optional and disabled by default.
DISCORD_TO_SITE_SYNC=false
# Whether to automatically ban/unban users in Discord when banned/unbanned on
# the website.  Enabled by default.
DISCORD_BAN_SYNC_ENABLED=true

# -----------------------------------------------------------------------------
# End of environment template
# -----------------------------------------------------------------------------