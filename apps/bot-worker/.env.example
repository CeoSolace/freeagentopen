# Discord bot token
DISCORD_BOT_TOKEN=

# Discord guild to operate in
DISCORD_GUILD_ID=1457959036304756736

# Role that is granted on successful website verification
DISCORD_MEMBER_ROLE_ID=

# Channel ID where the bot posts the verification message
DISCORD_VERIFY_CHANNEL_ID=

# Base URL of the website for building verification links
APP_URL=

# Internal shared secret for authenticating API requests from the website
INTERNAL_SHARED_SECRET=

# Secret for cron/job endpoints to prevent unauthorized access
CRON_SECRET=

# MongoDB connection URI
MONGODB_URI=

# Comma separated list of Discord user IDs that should always be considered owners
OWNER_USER_IDS=

# Comma separated list of Discord user IDs that have admin privileges
ADMIN_USER_IDS=

# Flags to enable optional sync behaviours
DISCORD_ROLE_SYNC_ENABLED=true
DISCORD_TO_SITE_SYNC=false
DISCORD_BAN_SYNC_ENABLED=true

# Optional encryption key used for token hashing/verification (leave empty to use random)
TOKEN_ENCRYPTION_KEY=